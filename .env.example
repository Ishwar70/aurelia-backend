# Required in production so sessions survive across serverless instances.
SESSION_SECRET=

# Leave empty to run on the seeded in-memory store (fine for local demo).
# Set a MongoDB Atlas URI for durable carts, orders, and admin edits.
MONGODB_URI=
MONGODB_DB=aurelia

# Comma-separated browser origins allowed to call the API directly.
WEB_ORIGINS=http://localhost:3000

# Optional. Without these, checkout uses the sandbox payment adapter.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional. Without this, the assistant uses the grounded rules engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Kill switches.
AI_ENABLED=true
VISUAL_SEARCH_ENABLED=true
